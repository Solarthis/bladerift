{
  "name": "@bladerift/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "build:online": "esbuild src/online.ts --bundle --platform=node --format=esm --target=node20 --external:bufferutil --external:utf-8-validate --outfile=dist/online.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@bladerift/shared": "0.1.0",
    "ws": "^8.22.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "@types/qrcode": "^1.5.5",
    "esbuild": "^0.28.2"
  }
}
