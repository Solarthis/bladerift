# Bladerift router (generated by deploy/deploy-hostinger.sh). Lives at public_html/bladerift/.htaccess. Active release: __RELEASE__
Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  # This file sits in /bladerift/: the patterns below see paths relative to that folder (index.html, assets/..., r/...).
  RewriteBase /bladerift/
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Already inside a release directory: serve as-is (prevents rewrite loops; internal rewrites re-enter this file).
  RewriteRule ^r/ - [L]
  # Existing file in the active release -> serve it. DOCUMENT_ROOT is the site root (public_html), so the path names bladerift/ too.
  RewriteCond %{DOCUMENT_ROOT}/bladerift/r/__RELEASE__/$1 -f
  RewriteRule ^(.*)$ r/__RELEASE__/$1 [L]
  # Everything else (the bare /bladerift/ URL, client-side routes) -> the app shell.
  RewriteRule ^ r/__RELEASE__/index.html [L]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Content-hashed bundles are immutable; generated art, manifests, the service worker and the shell must revalidate.
  # no-transform on everything: Hostinger's CDN otherwise re-encodes/resizes images per device (it shrank
  # texture atlases on iPhones, which broke every terrain frame). Content-hashed files are immutable.
  Header set Cache-Control "no-cache, no-transform"
  <FilesMatch "(-[A-Za-z0-9_-]{8}\.(js|css|woff2?)|\.[0-9a-f]{10}\.(png|json))$">
    Header set Cache-Control "public, max-age=31536000, immutable, no-transform"
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
